{"version":2,"width":120,"height":32,"timestamp":1785079026,"idle_time_limit":1.5,"command":"./scripts/asciinema-demo.sh","title":"CryptoWrapper quick start","env":{"SHELL":"/bin/zsh"},"theme":{"fg":"#e6e6e6","bg":"#212733","palette":"#35424b:#b45547:#6caa71:#c4ac62:#6d96b4:#bd7bcd:#7ccbce:#dee6ec:#465c6d:#e06c5a:#79be7e:#e5c872:#67b5ed:#d389e5:#84dee1:#e6eff6"}}
[0.011156, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.011364, "o", "\u001b[1;35mCryptoWrapper: key generation, signing, verification, and hashing\u001b[0m\r\n\r\n"]
[1.01917, "o", "\u001b[1;36m$ cw doctor\u001b[0m\r\n"]
[1.623757, "o", "OpenSSL: 3.6.3 (/opt/homebrew/bin/openssl)\r\nProviders: default\r\nlibcrypto: OpenSSL 3.6.3 9 Jun 2026\r\nStatus: supported\r\n"]
[1.624511, "o", "\r\n"]
[2.432032, "o", "\u001b[0;33mThis demo uses an unencrypted disposable key to stay non-interactive.\u001b[0m\r\n\u001b[0;33mFor real keys, omit --no-passphrase and enter a hidden passphrase.\u001b[0m\r\n\r\n"]
[3.442357, "o", "\u001b[1;36m$"]
[3.442431, "o", " cw keygen ed25519 --no-passphrase --out signing.key.pem --public-out signing.pub.pem\u001b[0m\r\n"]
[3.485508, "o", "Private key: signing.key.pem\r\nPublic key: signing.pub.pem\r\nFingerprint: SHA256:F75C189F24ABA8563099C9D0256B27EFAF25DF01582DEEB737178B3BE8C64B7B\r\n"]
[3.486333, "o", "\r\n"]
[4.292826, "o", "\u001b[1;36m$ printf 'Hello from CryptoWrapper\\n' > message.txt\u001b[0m\r\n"]
[4.293516, "o", "\r\n"]
[5.103885, "o", "\u001b[1;36m$ cw sign --no-passphrase --key signing.key.pem --in message.txt --out message.txt.sig\u001b[0m\r\n"]
[5.142353, "o", "Signature: message.txt.sig (ed25519)\r\n"]
[5.143359, "o", "\r\n"]
[5.952663, "o", "\u001b[1;36m$"]
[5.952766, "o", " cw verify --key signing.pub.pem --in message.txt --signature message.txt.sig\u001b[0m\r\n"]
[5.995498, "o", "Signature verified\r\n"]
[5.996397, "o", "\r\n"]
[6.803288, "o", "\u001b[1;36m$ cw hash sha256 --in message.txt\u001b[0m\r\n"]
[6.834957, "o", "3573457642d2fe6a765e2204f5d3f5d41cad02ebce4453dc21e3ce1e586b64e7  message.txt\r\n"]
[6.835994, "o", "\r\n"]
[7.644945, "o", "\u001b[1;36m$ cw inspect --type public-key --in signing.pub.pem\u001b[0m\r\n"]
[7.677063, "o", "ED25519 Public-Key:\r\npub:\r\n    cc:ca:37:5c:e4:73:0a:49:80:44:8a:5e:da:35:1f:\r\n    69:33:83:3d:6f:f3:74:eb:d4:ae:a8:0b:ef:7c:b4:\r\n    d2:88\r\n"]
[7.67808, "o", "\r\n"]
[8.487274, "o", "\u001b[1;32mDone. The signature is valid and all files were written safely.\u001b[0m\r\n"]
[8.496151, "x", "0"]
