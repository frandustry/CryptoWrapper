{"version":2,"width":120,"height":32,"timestamp":1785078710,"idle_time_limit":1.5,"command":"./scripts/asciinema-demo.sh","title":"CryptoWrapper quick start","env":{"SHELL":"/bin/zsh"}}
[0.009931, "o", "\u001b[1;35mCryptoWrapper: key generation, signing, verification, and hashing\u001b[0m\r\n\r\n"]
[1.016728, "o", "\u001b[1;36m$ cw doctor\u001b[0m\r\n"]
[1.495289, "o", "OpenSSL: 3.6.3 (/opt/homebrew/bin/openssl)\r\nProviders: default\r\nlibcrypto: OpenSSL 3.6.3 9 Jun 2026\r\n"]
[1.495297, "o", "Status: supported\r\n"]
[1.495963, "o", "\r\n"]
[2.30154, "o", "\u001b[0;33mThis demo uses an unencrypted disposable key to stay non-interactive.\u001b[0m\r\n\u001b[0;33mFor real keys, omit --no-passphrase and enter a hidden passphrase.\u001b[0m\r\n\r\n"]
[3.311259, "o", "\u001b[1;36m$"]
[3.311274, "o", " cw keygen ed25519 --no-passphrase --out signing.key.pem --public-out signing.pub.pem\u001b[0m\r\n"]
[3.361757, "o", "Private key: signing.key.pem\r\nPublic key: signing.pub.pem\r\nFingerprint: SHA256:0E69E07CAA80D11322DBC741B6A38AA983A0198FA2BD4A7ADD8FDB4DB8A2A73E\r\n"]
[3.362416, "o", "\r\n"]
[4.170189, "o", "\u001b[1;36m$ printf 'Hello from CryptoWrapper\\n' > message.txt\u001b[0m\r\n"]
[4.170578, "o", "\r\n"]
[4.976432, "o", "\u001b[1;36m$"]
[4.976451, "o", " cw sign --no-passphrase --key signing.key.pem --in message.txt --out message.txt.sig"]
[4.976494, "o", "\u001b[0m\r\n"]
[5.018684, "o", "Signature: message.txt.sig (ed25519)\r\n"]
[5.019654, "o", "\r\n"]
[5.827487, "o", "\u001b[1;36m$ cw verify --key signing.pub.pem --in message.txt --signature message.txt.sig"]
[5.827496, "o", "\u001b[0m\r\n"]
[5.868, "o", "Signature verified\r\n"]
[5.868974, "o", "\r\n"]
[6.675095, "o", "\u001b[1;36m$ cw hash sha256 --in message.txt"]
[6.67512, "o", "\u001b[0m\r\n"]
[6.710475, "o", "3573457642d2fe6a765e2204f5d3f5d41cad02ebce4453dc21e3ce1e586b64e7  message.txt\r\n"]
[6.711621, "o", "\r\n"]
[7.518074, "o", "\u001b[1;36m$ cw inspect --type public-key --in signing.pub.pem\u001b[0m\r\n"]
[7.539031, "o", "ED25519 Public-Key:\r\npub:\r\n    88:e6:e6:31:18:fd:0b:32:5f:08:e5:90:92:1f:ec:\r\n    bd:61:05:8d:ff:33:14:b7:55:11:2b:3f:cc:7a:f2:\r\n    68:f6\r\n"]
[7.539687, "o", "\r\n"]
[8.347842, "o", "\u001b[1;32mDone. The signature is valid and all files were written safely.\u001b[0m\r\n"]
[8.356911, "x", "0"]
